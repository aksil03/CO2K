generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Utilisateur {
  id             Int               @id @default(autoincrement())
  nom            String
  prenom         String
  email          String            @unique
  password       String
  age            Int
  poids          Float
  taille         Int
  genre          Genre             @default(HOMME)
  activite       NiveauActivite    @default(MODERE)
  objectif       ObjectifPhysique  @default(MAINTIEN)
  regime         RegimeAlimentaire @default(STANDARD)
  commentaires   Commentaire[]
  mesAbonnements Follow[]          @relation("MesAbonnements")
  mesAbonnes     Follow[]          @relation("MesAbonnes")
  likes          Like[]
  plannings      Planning[]
  posts          Post[]
  programmes     Programme[]
  repas          Repas[]
}

model Follow {
  id_abonne Int
  id_star   Int
  abonne    Utilisateur @relation("MesAbonnements", fields: [id_abonne], references: [id])
  star      Utilisateur @relation("MesAbonnes", fields: [id_star], references: [id])

  @@id([id_abonne, id_star])
}

model Post {
  id           Int           @id @default(autoincrement())
  titre        String
  contenu      String
  createdAt    DateTime      @default(now())
  auteurId     Int
  planningId   Int?
  programmeId  Int?
  commentaires Commentaire[]
  likes        Like[]
  auteur       Utilisateur   @relation(fields: [auteurId], references: [id])
  planning     Planning?     @relation(fields: [planningId], references: [id], onDelete: Cascade)
  programme    Programme?    @relation(fields: [programmeId], references: [id], onDelete: Cascade)
}

model Commentaire {
  id        Int           @id @default(autoincrement())
  texte     String
  createdAt DateTime      @default(now())
  postId    Int
  auteurId  Int
  parentId  Int?
  auteur    Utilisateur   @relation(fields: [auteurId], references: [id])
  parent    Commentaire?  @relation("Reponses", fields: [parentId], references: [id], onDelete: Cascade)
  reponses  Commentaire[] @relation("Reponses")
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Like {
  id     Int         @id @default(autoincrement())
  postId Int
  userId Int
  post   Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   Utilisateur @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model Planning {
  id          Int                  @id @default(autoincrement())
  nom         String
  description String?
  auteurId    Int
  createdAt   DateTime             @default(now())
  calendriers CalendrierPlanning[]
  auteur      Utilisateur          @relation(fields: [auteurId], references: [id])
  posts       Post[]
  repas       Repas[]
}

model Repas {
  id            Int           @id @default(autoincrement())
  dateConsom    DateTime
  numJour       Int           @default(1)
  type          MomentRepas   @default(DEJEUNER)
  nomTemplate   TemplateRepas
  utilisateurId Int
  planningId    Int?
  portions      Portion[]
  planning      Planning?     @relation(fields: [planningId], references: [id])
  utilisateur   Utilisateur   @relation(fields: [utilisateurId], references: [id])
}

model Portion {
  id        Int     @id @default(autoincrement())
  quantite  Float
  repasId   Int
  alimentId Int
  aliment   Aliment @relation(fields: [alimentId], references: [id])
  repas     Repas   @relation(fields: [repasId], references: [id])
}

model Aliment {
  id          Int        @id @default(autoincrement())
  nom         String
  bac         BacAliment
  co2         Float
  cal         Int
  prot        Float?
  lip         Float?
  glu         Float?
  sucre       Float?
  sel         Float?
  gras_sat    Float?
  estSnack    Boolean    @default(false)
  estPlat     Boolean    @default(false)
  estSandwich Boolean    @default(false)
  estVege     Boolean    @default(true)
  portions    Portion[]
}

model Programme {
  id          Int                  @id @default(autoincrement())
  nom         String
  description String?
  auteurId    Int
  createdAt   DateTime             @default(now())
  semaines    CalendrierPlanning[]
  posts       Post[]
  auteur      Utilisateur          @relation(fields: [auteurId], references: [id])
}

model CalendrierPlanning {
  id           Int       @id @default(autoincrement())
  semaineDebut DateTime
  ordre        Int
  planningId   Int?
  programmeId  Int
  planning     Planning? @relation(fields: [planningId], references: [id])
  programme    Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
}

enum TemplateRepas {
  PETIT_DEJ
  HOT
  SANDWICH
  WRAP
  SALADE
  COLLATION
}

enum MomentRepas {
  PETIT_DEJEUNER
  DEJEUNER
  COLLATION
  DINER
}

enum BacAliment {
  PROT_PORC
  PROT_VIANDE_ROUGE
  PROT_VOLAILLE
  PROT_BLANCHE_AUTRE
  PROT_P
  PROT_VEG
  RIZ
  PATE
  NOUILLE
  GNOCCHI
  CERE_REPAS
  SEMOU
  POTATO
  PAIN
  WRAP
  LEG
  LAITUE
  FROMAGE
  FRUIT_ENTIER
  FRUIT_PULPE
  CERE
  LAIT
  S_HOT_RED
  S_HOT_WHITE
  S_HOT_ASIA
  S_COLD
  VINAIGRETTE
  OLEAGINEUX
  BC
  GAL_RIZ
  HUILE
}

enum ObjectifPhysique {
  PRISE_DE_MASSE
  PERTE_DE_GRAS
  MAINTIEN
}

enum NiveauActivite {
  SEDENTAIRE
  LEGER
  MODERE
  INTENSE
  EXTREME
}

enum Genre {
  HOMME
  FEMME
}

enum RegimeAlimentaire {
  STANDARD
  SANS_PORC
  SANS_VIANDE
}
